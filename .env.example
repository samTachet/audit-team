# Copier vers .env (non versionné). Clés de DÉVELOPPEMENT uniquement : en production, générer des clés aléatoires
# et les injecter via le gestionnaire de secrets de la plateforme.
ACSI_API_KEYS={"dev-key-alice":{"id":"alice","role":"lead_auditor"},"dev-key-bob":{"id":"bob","role":"lead_auditor"},"dev-key-carol":{"id":"carol","role":"viewer"}}
# Optionnel mais recommandé : clé HMAC du journal (à garder HORS des volumes journal/ancres). Sans clé, la chaîne
# de hachage détecte les modifications accidentelles et les troncatures, mais n'authentifie rien.
# ACSI_JOURNAL_HMAC_KEY=remplacer-par-une-valeur-aléatoire-longue
# Runner des phases : crewai (défaut) ou direct (graphe LangGraph sans CrewAI)
# AUDIT_TEAM_RUNNER=crewai
# Balayage périodique des missions orphelines (secondes, 0 = désactivé)
# AUDIT_TEAM_SWEEP_INTERVAL_S=60
